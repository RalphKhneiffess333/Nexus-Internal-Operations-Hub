# Backend API origin. Leave empty for same-origin production or Vite dev proxy.
# If set, include the backend prefix, for example https://nexus.example.com/api.
# Set this for a deployed frontend or when the browser should call the backend directly.
VITE_API_URL=

# Local Vite proxy target and frontend development port.
VITE_DEV_API_URL=http://localhost:3000
VITE_DEV_PORT=5173

