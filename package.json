{
  "name": "nexus",
  "private": true,
  "workspaces": [
    "backend",
    "frontend/nexus"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "concurrently \"npm run start:dev --workspace=backend\" \"npm run dev --workspace=@nexus/frontend\"",
    "start:test": "concurrently --kill-others-on-fail \"npm run start:test --workspace=backend\" \"npm run dev --workspace=@nexus/frontend\"",
    "start:backend": "npm run start:dev --workspace=backend",
    "start:frontend": "npm run dev --workspace=@nexus/frontend",
    "db:setup": "npm run prisma:migrate --workspace=backend && npm run prisma:seed --workspace=backend",
    "seed:users": "npm run seed:users --workspace=backend",
    "seed:bulk": "npm run seed:bulk --workspace=backend",
    "seed:bulk:test": "npm run seed:bulk:test --workspace=backend",
    "eval": "npm run eval --workspace=backend",
    "test": "npm run test --workspace=backend && npm run test:integration --workspace=backend && npm run test:e2e --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
