DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nexus
DATABASE_USER=nexus
DATABASE_PASSWORD=

# Prisma CLI and the NestJS Prisma client both use this URL.
# Build it from the variables above: postgresql://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgresql://nexus:PASSWORD@localhost:5432/nexus

# Microsoft Entra ID authentication.
# Fill these with the values from the Microsoft Entra app registration.
MICROSOFT_ENTRA_TENANT_ID=
MICROSOFT_ENTRA_CLIENT_ID=
MICROSOFT_ENTRA_CLIENT_SECRET=
MICROSOFT_ENTRA_REDIRECT_URI=http://localhost:3000/authentication/microsoft/callback
MICROSOFT_ENTRA_SCOPES=openid profile email

# Frontend URL used after a successful Microsoft login.
FRONTEND_URL=http://localhost:5173

# Optional asynchronous email notifications through Nodemailer/SMTP.
# Leave SMTP_HOST and SMTP_FROM_EMAIL empty to disable delivery locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nexus
SMTP_ENABLED=true
SMTP_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=250
APP_BASE_URL=http://localhost:5173

# Local file attachment storage. Relative paths are resolved from the backend working directory.
FILE_UPLOAD_DIR=uploads

# Background workers. Set BACKGROUND_WORKERS_ENABLED=false to disable them locally.
BACKGROUND_WORKERS_ENABLED=true
ORPHANED_FILE_CLEANUP_INTERVAL_MS=3600000
AUDIT_LOG_CLEANUP_INTERVAL_MS=86400000
UNCLAIMED_TICKET_REMINDER_INTERVAL_MS=300000
FILE_ORPHAN_GRACE_PERIOD_MS=3600000
