{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "node scripts/deploy.js",
    "deploy:ci": "npm run build && npm run prisma:migrate && npm run prisma:seed && npm run test",
    "typecheck": "tsc --noEmit --project tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:test": "ts-node --project tsconfig.scripts.json test/manual-test-server.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test:prepare": "ts-node --project tsconfig.scripts.json test/prepare-test-database.ts",
    "test:unit:run": "jest",
    "test:integration:run": "jest --config ./test/jest-integration.json",
    "test:api:e2e:run": "npm run build && playwright test --config ./test/playwright.api.config.ts",
    "test:browser:e2e:run": "playwright test --config ./test/playwright.config.ts",
    "test:e2e:run": "npm run test:api:e2e:run && npm run test:browser:e2e:run",
    "test:smoke:api:run": "npm run build && playwright test --config ./test/playwright.smoke.api.config.ts",
    "test:smoke:browser:run": "playwright test --config ./test/playwright.smoke.browser.config.ts",
    "test:smoke:run": "npm run test:smoke:api:run && npm run test:smoke:browser:run",
    "test": "npm run test:prepare && npm run test:unit:run",
    "test:watch": "npm run test:prepare && npm run test:unit:run -- --watch",
    "test:cov": "npm run test:prepare && npm run test:unit:run -- --coverage",
    "test:debug": "npm run test:prepare && node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "npm run test:prepare && npm run test:integration:run",
    "test:api:e2e": "npm run test:prepare && npm run test:api:e2e:run",
    "test:browser:e2e": "npm run test:prepare && npm run test:browser:e2e:run",
    "test:e2e": "npm run test:prepare && npm run test:e2e:run",
    "test:smoke": "npm run test:prepare && npm run test:smoke:run",
    "eval": "ts-node --project tsconfig.scripts.json src/ai/ai-model.eval.ts",
    "seed:bulk": "ts-node --project tsconfig.scripts.json src/database/bulk-seed.ts normal",
    "seed:bulk:test": "ts-node --project tsconfig.scripts.json src/database/bulk-seed.ts test",
    "seed:users": "ts-node --project tsconfig.scripts.json src/database/users-cli.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.scripts.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/websockets": "^11.2.3",
    "@prisma/client": "^6.16.2",
    "@types/nodemailer": "^8.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@inquirer/prompts": "^7.10.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.16.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "verbose": true,
    "maxWorkers": 1,
    "setupFiles": [
      "<rootDir>/../test/setup-integration-env.ts"
    ]
  }
}
