{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "verbose": true,
  "testTimeout": 30000,
  "testRegex": ".integration-spec.ts$",
  "setupFiles": ["<rootDir>/test/setup-integration-env.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "maxWorkers": 1
}
