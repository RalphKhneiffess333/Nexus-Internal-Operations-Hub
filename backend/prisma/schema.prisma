generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Employee
  Agent
  Admin
}

enum TicketPriority {
  LOW
  MODERATE
  HIGH
}

enum TicketStatus {
  OPEN
  CLAIMED
  CLOSED
  REOPENED
}

enum TicketEventAction {
  SUBMISSION
  CLAIM
  CLOSE
  REOPEN
  DELETE
  MODIFICATION
  HANDOFF
}

enum HandoffStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AuditAction {
  USER_PREPROVISIONING
  ROLE_MAPPING
  USER_ACTIVATION
  USER_DEACTIVATION
  DEPARTMENT_ADDITION
  DEPARTMENT_MODIFICATION
  DEPARTMENT_DELETION
  DEPARTMENT_REACTIVATION
  DEPARTMENT_MAPPING
  SYSTEM_VARIABLE_MODIFICATION
}

model IdentityProvider {
  identityProviderId String   @id @map("identity_provider_id")
  code               String
  name               String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  users              User[]

  @@map("identity_providers")
}

model User {
  userId                 String             @id @map("user_id")
  email                  String             @unique
  fullName               String             @map("full_name")
  phoneNumber            String?            @map("phone_number")
  role                   UserRole           @default(Employee)
  isActive               Boolean            @default(true) @map("is_active")
  hasLogged              Boolean            @map("has_logged")
  identityProviderId     String             @map("identity_provider_id")
  identityProviderUserId String?            @map("identity_provider_user_id")
  identityProvider       IdentityProvider   @relation(fields: [identityProviderId], references: [identityProviderId])
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")
  submittedTickets       Ticket[]           @relation("TicketSubmitter")
  assignedTickets        Ticket[]           @relation("TicketAgent")
  ticketEvents           TicketEvent[]
  uploadedFiles          File[]
  departmentMembers      DepartmentMember[]
  auditLogs              AuditLog[]
  handoffsRequested      HandoffRequest[]   @relation("HandoffRequester")
  handoffsReceived       HandoffRequest[]   @relation("HandoffRequestedAgent")

  @@unique([identityProviderId, identityProviderUserId])
  @@map("users")
}

model Department {
  departmentId String             @id @map("department_id")
  code         String             @unique
  name         String
  desc         String
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  tickets      Ticket[]
  members      DepartmentMember[]

  @@map("departments")
}

model DepartmentMember {
  departmentMemberId String     @id @map("department_member_id")
  userId             String     @map("user_id")
  departmentId       String     @map("department_id")
  createdAt          DateTime   @default(now()) @map("created_at")
  user               User       @relation(fields: [userId], references: [userId])
  department         Department @relation(fields: [departmentId], references: [departmentId])

  @@unique([userId, departmentId])
  @@index([departmentId])
  @@map("department_members")
}

model Ticket {
  ticketId        String           @id @map("ticket_id")
  ticketCode      String           @unique @map("ticket_code")
  title           String
  description     String
  priority        TicketPriority
  status          TicketStatus     @default(OPEN)
  departmentId    String           @map("department_id")
  submittedBy     String           @map("submitted_by")
  agentId         String?          @map("agent_id")
  active          Boolean          @default(true)
  completionNotes String?          @map("completion_notes")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  closedAt        DateTime?        @map("closed_at")
  department      Department       @relation(fields: [departmentId], references: [departmentId])
  submitter       User             @relation("TicketSubmitter", fields: [submittedBy], references: [userId])
  agent           User?            @relation("TicketAgent", fields: [agentId], references: [userId])
  events          TicketEvent[]
  handoffs        HandoffRequest[]

  @@index([submittedBy])
  @@index([departmentId])
  @@index([agentId])
  @@index([status])
  @@index([departmentId, status, createdAt])
  @@map("tickets")
}

model TicketEvent {
  ticketEventId String            @id @map("ticket_event_id")
  ticketId      String            @map("ticket_id")
  userId        String            @map("user_id")
  action        TicketEventAction
  details       Json
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  ticket        Ticket            @relation(fields: [ticketId], references: [ticketId])
  user          User              @relation(fields: [userId], references: [userId])
  attachments   Attachment[]

  @@index([ticketId, createdAt])
  @@index([createdAt])
  @@map("ticket_events")
}

model HandoffRequest {
  handoffId        String        @id @map("handoff_id")
  ticketId         String        @map("ticket_id")
  requesterId      String        @map("requester_id")
  requestedAgentId String        @map("requested_agent_id")
  status           HandoffStatus @default(PENDING)
  message          String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  resolvedAt       DateTime?     @map("resolved_at")
  ticket           Ticket        @relation(fields: [ticketId], references: [ticketId], onDelete: Restrict)
  requester        User          @relation("HandoffRequester", fields: [requesterId], references: [userId], onDelete: Restrict)
  requestedAgent   User          @relation("HandoffRequestedAgent", fields: [requestedAgentId], references: [userId], onDelete: Restrict)

  @@index([ticketId, status])
  @@index([requestedAgentId, status])
  @@index([requesterId, status])
  @@index([createdAt])
  @@map("handoff_requests")
}

model File {
  fileId       String      @id @map("file_id")
  uploadedBy   String      @map("uploaded_by")
  originalName String      @map("original_name")
  storageKey   String      @unique @map("storage_key")
  fileSize     Int         @map("file_size")
  mimeType     String      @map("mime_type")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  uploader     User        @relation(fields: [uploadedBy], references: [userId])
  attachment   Attachment?

  @@index([uploadedBy])
  @@map("files")
}

model Attachment {
  attachmentId String       @id @map("attachment_id")
  fileId       String       @unique @map("file_id")
  eventId      String?      @map("event_id")
  messageId    String?      @map("message_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  file         File         @relation(fields: [fileId], references: [fileId])
  event        TicketEvent? @relation(fields: [eventId], references: [ticketEventId], onDelete: SetNull)

  @@index([eventId])
  @@index([messageId])
  @@map("attachments")
}

model SystemConfiguration {
  configurationId String   @id @map("configuration_id")
  key             String   @unique
  value           String
  description     String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("system_configurations")
}

model AuditLog {
  auditLogId String      @id @map("audit_log_id")
  action     AuditAction
  actorId    String?     @map("actor_id")
  details    Json
  createdAt  DateTime    @default(now()) @map("created_at")
  actor      User?       @relation(fields: [actorId], references: [userId], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
