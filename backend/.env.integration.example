# Copy this file to backend/.env.integration and point it at a separate local
# PostgreSQL database reserved for integration tests.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nexus_integration
DATABASE_USER=nexus
DATABASE_PASSWORD=

# Prisma and the NestJS Prisma client use DATABASE_URL when it is set.
# Keep this pointed at the same separate integration database above.
DATABASE_URL=postgresql://nexus:PASSWORD@localhost:5432/nexus_integration

# Required by the authentication module configuration, even though the
# integration test mocks the Microsoft auth strategy and does not call Microsoft.
MICROSOFT_ENTRA_TENANT_ID=test-tenant
MICROSOFT_ENTRA_CLIENT_ID=test-client
MICROSOFT_ENTRA_CLIENT_SECRET=test-secret
MICROSOFT_ENTRA_REDIRECT_URI=http://localhost:3000/authentication/microsoft/callback
MICROSOFT_ENTRA_SCOPES=openid profile email

FRONTEND_URL=http://localhost:5173

# Optional AI assistant settings. Add a real key only if you want AI responses
# while running the test server.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_RETRY_DELAY_MS=250

# Keep email disabled for automated tests and local test-authentication mode.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Nexus
SMTP_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=250
APP_BASE_URL=http://localhost:5173
